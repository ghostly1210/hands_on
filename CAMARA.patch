+++ b/app/src/main/java/com/uvg/bienvenida/ui/camara/CameraPreview.kt
@@ -0,0 +1,173 @@
+package com.uvg.bienvenida.ui.camara
+
+import android.hardware.display.DisplayManager
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.util.Log
+import android.util.Size
+import android.view.Surface
+import androidx.camera.core.CameraSelector
+import androidx.camera.core.CameraState
+import androidx.camera.core.ImageAnalysis
+import androidx.camera.core.Preview
+import androidx.camera.core.resolutionselector.AspectRatioStrategy
+import androidx.camera.core.resolutionselector.ResolutionSelector
+import androidx.camera.core.resolutionselector.ResolutionStrategy
+import androidx.camera.lifecycle.ProcessCameraProvider
+import androidx.camera.view.PreviewView
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberUpdatedState
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.viewinterop.AndroidView
+import androidx.core.content.ContextCompat
+import androidx.lifecycle.LiveData
+import androidx.lifecycle.Observer
+import androidx.lifecycle.compose.LocalLifecycleOwner
+import java.util.concurrent.Executors
+import java.util.concurrent.atomic.AtomicBoolean
+
+/** Solo se monta cuando hay permiso y la pantalla está visible. */
+@Composable
+internal fun CameraPreview(
+    requestedLens: Int,
+    modifier: Modifier = Modifier,
+    onFrame: ((CameraFrame) -> Unit)?,
+    onCameraInfo: (actualLens: Int, canSwitch: Boolean) -> Unit,
+    onStreaming: (Boolean) -> Unit,
+    onError: (String) -> Unit
+) {
+    val context = LocalContext.current
+    val lifecycleOwner = LocalLifecycleOwner.current
+    val frameCallback = rememberUpdatedState(onFrame)
+    val infoCallback = rememberUpdatedState(onCameraInfo)
+    val streamingCallback = rememberUpdatedState(onStreaming)
+    val errorCallback = rememberUpdatedState(onError)
+    val previewView = remember(context) {
+        PreviewView(context).apply {
+            implementationMode = PreviewView.ImplementationMode.COMPATIBLE
+            // Muestra la imagen completa; evita recortar dedos en el encuadre.
+            scaleType = PreviewView.ScaleType.FIT_CENTER
+        }
+    }
+
+    AndroidView(factory = { previewView }, modifier = modifier)
+
+    DisposableEffect(previewView, lifecycleOwner, requestedLens) {
+        val active = AtomicBoolean(true)
+        val mainExecutor = ContextCompat.getMainExecutor(context)
+        val executor = Executors.newSingleThreadExecutor()
+        val resolution = ResolutionSelector.Builder()
+            .setAspectRatioStrategy(AspectRatioStrategy.RATIO_4_3_FALLBACK_AUTO_STRATEGY)
+            .setResolutionStrategy(
+                ResolutionStrategy(Size(640, 480), ResolutionStrategy.FALLBACK_RULE_CLOSEST_HIGHER_THEN_LOWER)
+            ).build()
+        val rotation = previewView.display?.rotation ?: Surface.ROTATION_0
+        val preview = Preview.Builder().setTargetRotation(rotation).build()
+        val analysis = ImageAnalysis.Builder()
+            .setResolutionSelector(resolution)
+            .setTargetRotation(rotation)
+            .setOutputImageFormat(ImageAnalysis.OUTPUT_IMAGE_FORMAT_RGBA_8888)
+            .setBackpressureStrategy(ImageAnalysis.STRATEGY_KEEP_ONLY_LATEST)
+            .build()
+        var provider: ProcessCameraProvider? = null
+        var cameraState: LiveData<CameraState>? = null
+        val cameraObserver = Observer<CameraState> { state ->
+            if (active.get() && state.error != null) {
+                errorCallback.value("No se puede usar la cámara. Cierra otras apps que la estén usando y reintenta.")
+            }
+        }
+        val streamObserver = Observer<PreviewView.StreamState> { state ->
+            if (active.get()) streamingCallback.value(state == PreviewView.StreamState.STREAMING)
+        }
+        previewView.previewStreamState.observe(lifecycleOwner, streamObserver)
+
+        // También cubre giros de 180° que no recrean la actividad.
+        val displayManager = context.getSystemService(DisplayManager::class.java)
+        val displayListener = object : DisplayManager.DisplayListener {
+            override fun onDisplayAdded(displayId: Int) = Unit
+            override fun onDisplayRemoved(displayId: Int) = Unit
+            override fun onDisplayChanged(displayId: Int) {
+                val display = previewView.display ?: return
+                if (active.get() && display.displayId == displayId) {
+                    preview.targetRotation = display.rotation
+                    analysis.targetRotation = display.rotation
+                }
+            }
+        }
+        displayManager.registerDisplayListener(displayListener, Handler(Looper.getMainLooper()))
+
+        val future = ProcessCameraProvider.getInstance(context)
+        future.addListener({
+            if (active.get()) {
+                try {
+                    val currentProvider = future.get()
+                    provider = currentProvider
+                    val front = currentProvider.hasCamera(CameraSelector.DEFAULT_FRONT_CAMERA)
+                    val back = currentProvider.hasCamera(CameraSelector.DEFAULT_BACK_CAMERA)
+                    check(front || back) { "No hay cámaras disponibles" }
+                    val actualLens = when {
+                        requestedLens == CameraSelector.LENS_FACING_FRONT && front -> CameraSelector.LENS_FACING_FRONT
+                        requestedLens == CameraSelector.LENS_FACING_BACK && back -> CameraSelector.LENS_FACING_BACK
+                        front -> CameraSelector.LENS_FACING_FRONT
+                        else -> CameraSelector.LENS_FACING_BACK
+                    }
+                    val selector = CameraSelector.Builder().requireLensFacing(actualLens).build()
+                    infoCallback.value(actualLens, front && back)
+                    preview.setSurfaceProvider(previewView.surfaceProvider)
+                    var lastFrameTime = -1L
+                    analysis.setAnalyzer(executor) { image ->
+                        try {
+                            val callback = frameCallback.value
+                            val now = SystemClock.elapsedRealtime()
+                            // Hasta 10 entregas/s; si el modelo tarda más, CameraX descarta imágenes viejas.
+                            if (active.get() && callback != null &&
+                                (lastFrameTime < 0 || now - lastFrameTime >= 100)
+                            ) {
+                                lastFrameTime = now
+                                val bitmap = image.toBitmap()
+                                try {
+                                    callback(CameraFrame(bitmap, image.imageInfo.rotationDegrees,
+                                        now, actualLens == CameraSelector.LENS_FACING_FRONT))
+                                } finally {
+                                    bitmap.recycle()
+                                }
+                            }
+                        } catch (error: Exception) {
+                            Log.e("HandsOnCamera", "Error en el consumidor de imágenes", error)
+                            mainExecutor.execute {
+                                if (active.get()) errorCallback.value("No se pudo procesar la imagen. Reintenta la cámara.")
+                            }
+                        } finally {
+                            // Indispensable incluso si falla el futuro analizador.
+                            image.close()
+                        }
+                    }
+                    val camera = currentProvider.bindToLifecycle(lifecycleOwner, selector, preview, analysis)
+                    cameraState = camera.cameraInfo.cameraState
+                    cameraState?.observe(lifecycleOwner, cameraObserver)
+                } catch (error: Exception) {
+                    Log.e("HandsOnCamera", "No se pudo iniciar la cámara", error)
+                    if (active.get()) errorCallback.value(
+                        "No se pudo abrir la cámara. Comprueba el permiso y que tu dispositivo tenga una cámara disponible."
+                    )
+                }
+            }
+        }, mainExecutor)
+
+        onDispose {
+            // El proveedor es compartido: no cancelar su Future ni usar unbindAll().
+            active.set(false)
+            displayManager.unregisterDisplayListener(displayListener)
+            previewView.previewStreamState.removeObserver(streamObserver)
+            cameraState?.removeObserver(cameraObserver)
+            analysis.clearAnalyzer()
+            provider?.unbind(preview, analysis)
+            preview.setSurfaceProvider(null)
+            executor.shutdown()
+        }
+    }
+}
diff --git a/app/src/main/java/com/uvg/bienvenida/ui/camara/CameraScreen.kt b/app/src/main/java/com/uvg/bienvenida/ui/camara/CameraScreen.kt
new file mode 100644
--- /dev/null
+++ b/app/src/main/java/com/uvg/bienvenida/ui/camara/CameraScreen.kt
@@ -0,0 +1,154 @@
+package com.uvg.bienvenida.ui.camara
+
+import android.Manifest
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.provider.Settings
+import androidx.activity.compose.rememberLauncherForActivityResult
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.camera.core.CameraSelector
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.filled.ArrowBack
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.runtime.saveable.rememberSaveable
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.clip
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.unit.dp
+import androidx.core.content.ContextCompat
+import androidx.lifecycle.Lifecycle
+import androidx.lifecycle.LifecycleEventObserver
+import androidx.lifecycle.compose.LocalLifecycleOwner
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun CameraScreen(
+    tituloLeccion: String,
+    onBack: () -> Unit,
+    onFrame: ((CameraFrame) -> Unit)? = null
+) {
+    val context = LocalContext.current
+    val lifecycleOwner = LocalLifecycleOwner.current
+    fun hasPermission() = ContextCompat.checkSelfPermission(context, Manifest.permission.CAMERA) ==
+        PackageManager.PERMISSION_GRANTED
+    var granted by remember { mutableStateOf(hasPermission()) }
+    var denied by rememberSaveable { mutableStateOf(false) }
+    var visible by remember {
+        mutableStateOf(lifecycleOwner.lifecycle.currentState.isAtLeast(Lifecycle.State.STARTED))
+    }
+    var requestedLens by rememberSaveable { mutableIntStateOf(CameraSelector.LENS_FACING_FRONT) }
+    var actualLens by remember { mutableIntStateOf(requestedLens) }
+    var canSwitch by remember { mutableStateOf(false) }
+    var streaming by remember { mutableStateOf(false) }
+    var error by remember { mutableStateOf<String?>(null) }
+    var attempt by remember { mutableIntStateOf(0) }
+    val permissionLauncher = rememberLauncherForActivityResult(ActivityResultContracts.RequestPermission()) {
+        granted = it
+        denied = !it
+        error = null
+    }
+
+    DisposableEffect(lifecycleOwner) {
+        val observer = LifecycleEventObserver { _, event ->
+            when (event) {
+                Lifecycle.Event.ON_START -> visible = true
+                Lifecycle.Event.ON_RESUME -> {
+                    // Actualiza también al regresar de Configuración o de un permiso temporal.
+                    granted = hasPermission()
+                    error = null
+                }
+                Lifecycle.Event.ON_STOP -> { visible = false; streaming = false }
+                else -> Unit
+            }
+        }
+        lifecycleOwner.lifecycle.addObserver(observer)
+        onDispose { lifecycleOwner.lifecycle.removeObserver(observer) }
+    }
+
+    Scaffold(topBar = {
+        TopAppBar(title = { Text("Practicar seña") }, navigationIcon = {
+            IconButton(onClick = onBack) { Icon(Icons.Default.ArrowBack, "Volver a la lección") }
+        })
+    }) { padding ->
+        Column(
+            Modifier.fillMaxSize().padding(padding).verticalScroll(rememberScrollState()).padding(20.dp),
+            verticalArrangement = Arrangement.spacedBy(16.dp)
+        ) {
+            Text(tituloLeccion, style = MaterialTheme.typography.titleLarge)
+            Text("Coloca tus manos dentro de la imagen, con buena iluminación.")
+            when {
+                !granted -> {
+                    Card(Modifier.fillMaxWidth()) {
+                        Column(Modifier.padding(20.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+                            Text(if (denied) "El permiso de cámara no está habilitado." else "Activa la cámara para practicar.")
+                            Text("La cámara permite ver tus señas mientras practicas.")
+                            Button(onClick = { permissionLauncher.launch(Manifest.permission.CAMERA) }) {
+                                Text("Permitir cámara")
+                            }
+                            if (denied) {
+                                Text("Si Android ya no muestra la solicitud, habilita Cámara en los permisos de la app.")
+                                TextButton(onClick = {
+                                    try {
+                                        context.startActivity(Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS,
+                                            Uri.parse("package:${context.packageName}")))
+                                    } catch (_: android.content.ActivityNotFoundException) {
+                                        error = "Abre Configuración del teléfono y habilita el permiso de Cámara para HandsOn."
+                                    }
+                                }) { Text("Abrir configuración") }
+                                error?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+                            }
+                        }
+                    }
+                }
+                error != null -> {
+                    Text(error.orEmpty(), color = MaterialTheme.colorScheme.error)
+                    Button(onClick = {
+                        granted = hasPermission()
+                        streaming = false
+                        canSwitch = false
+                        error = null
+                        attempt++
+                    }) { Text("Reintentar cámara") }
+                }
+                visible -> {
+                    key(attempt, requestedLens) {
+                        CameraPreview(
+                            requestedLens = requestedLens,
+                            modifier = Modifier.fillMaxWidth().aspectRatio(3f / 4f)
+                                .clip(RoundedCornerShape(20.dp)).background(Color.Black),
+                            onFrame = onFrame,
+                            onCameraInfo = { lens, switch -> actualLens = lens; canSwitch = switch },
+                            onStreaming = { streaming = it },
+                            onError = { streaming = false; error = it }
+                        )
+                    }
+                    Text(if (streaming) "Cámara lista" else "Abriendo cámara…")
+                    Text(if (actualLens == CameraSelector.LENS_FACING_FRONT)
+                        "Cámara frontal · vista en espejo" else "Cámara trasera")
+                    OutlinedButton(enabled = canSwitch, onClick = {
+                        streaming = false
+                        canSwitch = false
+                        requestedLens = if (actualLens == CameraSelector.LENS_FACING_FRONT)
+                            CameraSelector.LENS_FACING_BACK else CameraSelector.LENS_FACING_FRONT
+                    }) { Text("Cambiar cámara") }
+                }
+                else -> Box(Modifier.fillMaxWidth().height(160.dp), contentAlignment = Alignment.Center) {
+                    Text("Cámara pausada")
+                }
+            }
+            Text("El reconocimiento de señas todavía no está conectado.",
+                style = MaterialTheme.typography.bodyMedium)
+            Text("Las imágenes se usan en memoria: esta pantalla no guarda fotos ni graba videos.",
+                style = MaterialTheme.typography.bodySmall)
+        }
+    }
+}
